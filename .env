# =======================
# 应用基础配置
# =======================
APP_NAME=laravel
APP_DEBUG=true
APP_TIMEZONE="Asia/Shanghai"
APP_LOCALE=zh_CN

# =======================
# 日志配置
# =======================
APP_LOG_CHANNEL=daily
APP_LOG_LEVEL=debug

# =======================
# 数据库配置
# =======================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aaa
DB_USERNAME=root
DB_PASSWORD=root
DB_PREFIX=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

# =======================
# 会话配置（来自 config/session.php）
# =======================
SESSION_DRIVER=database# database native
SESSION_LIFETIME=120
SESSION_COOKIE=jnm_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
